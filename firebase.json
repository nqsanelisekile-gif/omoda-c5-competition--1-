{
  "functions": [
    {
      "source": "omoda-competition/functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "omoda-competition/firestore/firestore.rules",
    "indexes": "omoda-competition/firestore/firestore.indexes.json"
  },
  "storage": {
    "rules": "omoda-competition/firestore/storage.rules"
  }
}
