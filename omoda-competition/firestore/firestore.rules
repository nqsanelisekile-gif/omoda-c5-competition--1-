rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.entriesCount == 0 &&
        request.resource.data.keys().hasAll([
          'uid', 'email', 'firstName', 'lastName', 'displayName', 'phone',
          'role', 'createdAt', 'updatedAt', 'entriesCount'
        ]);
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'firstName', 'lastName', 'displayName', 'phone', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /entries/{entryId} {
      allow create: if false;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if false;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /entryCodes/{code} {
      allow read, write: if false;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /winners/{winnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
