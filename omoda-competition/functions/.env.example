# Copy to functions/.env for local Functions configuration.
# Never prefix these with VITE_ or put credentials in the frontend.
APP_BASE_URL=https://your-domain.example
PAYMENT_PROVIDER=yoco# Select the payment provider used by createEntrySession.
PAYMENT_PROVIDER=yoco
PAYFAST_SANDBOX=true

# Use the deployed HTTPS function URL, not the frontend URL.
PAYFAST_NOTIFY_URL=https://europe-west1-your-project.cloudfunctions.net/payfastWebhook
APP_BASE_URL=https://your-domain.example

# Set these with Firebase Secret Manager, not in this file:
# firebase functions:secrets:set YOCO_SECRET_KEY
# firebase functions:secrets:set YOCO_WEBHOOK_SECRET
# firebase functions:secrets:set PAYFAST_MERCHANT_ID
# firebase functions:secrets:set PAYFAST_MERCHANT_KEY
# firebase functions:secrets:set PAYFAST_PASSPHRASE
